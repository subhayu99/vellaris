# syntax=docker/dockerfile:1.7
# Multi-stage build for the Vellaris server.
#
# Targets:
#   runtime-slim — sqlite + local FS only (~120 MB).      Default tag (:VERSION).
#   runtime-full — every DB driver + cloud storage (~350 MB). Tag (:VERSION-full).

# ---------- builder ----------
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY alembic ./alembic
COPY alembic.ini ./

# Slim wheels = vellaris[server,sqlite] only.
RUN pip install --upgrade pip \
    && pip wheel --wheel-dir /build/wheels-slim ".[server,sqlite]"

# Full wheels = adds all DBs + cloud storage.
RUN pip wheel --wheel-dir /build/wheels-full ".[server,all-db,all-storage]"

# ---------- runtime-slim ----------
FROM python:3.12-slim AS runtime-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VELLARIS_HOST=0.0.0.0 \
    VELLARIS_PORT=8000

RUN groupadd --system vellaris \
    && useradd --system --gid vellaris --create-home --home-dir /home/vellaris vellaris

WORKDIR /app

COPY --from=builder /build/wheels-slim /tmp/wheels
RUN pip install --no-index --find-links=/tmp/wheels vellaris[server,sqlite] \
    && rm -rf /tmp/wheels

# Pre-create the default data directory so named-volume mounts inherit ownership.
RUN mkdir -p /data/blobs && chown -R vellaris:vellaris /data

USER vellaris

EXPOSE 8000

# Auto-migrate runs before uvicorn binds; bump start-period so the liveness
# probe doesn't fire mid-migration on a cold DB.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/healthz').read()" \
        || exit 1

CMD ["vellaris-server"]

# ---------- runtime-full ----------
FROM runtime-slim AS runtime-full

USER root
COPY --from=builder /build/wheels-full /tmp/wheels-full
RUN pip install --no-index --find-links=/tmp/wheels-full vellaris[server,all-db,all-storage] \
    && rm -rf /tmp/wheels-full
USER vellaris
