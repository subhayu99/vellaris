# syntax=docker/dockerfile:1.7
# Multi-stage build for the Vellaris server.
# Final image runs `vellaris-server` as a non-root user.

# ---------- builder ----------
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE ./
COPY src ./src

RUN pip install --upgrade pip \
    && pip wheel --wheel-dir /build/wheels ".[server]"

# ---------- runtime ----------
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VELLARIS_HOST=0.0.0.0 \
    VELLARIS_PORT=8000

RUN groupadd --system vellaris \
    && useradd --system --gid vellaris --create-home --home-dir /home/vellaris vellaris

WORKDIR /app

COPY --from=builder /build/wheels /tmp/wheels
RUN pip install --no-index --find-links=/tmp/wheels vellaris[server] \
    && rm -rf /tmp/wheels

USER vellaris

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/healthz').read()" \
        || exit 1

CMD ["vellaris-server"]
